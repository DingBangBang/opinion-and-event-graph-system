# ===========================================================================
# 复制为 .env 后按需修改：  cp .env.example .env
# docker compose 会读取 .env；本地直接运行的 Python 进程也会读取它。
# ===========================================================================

# ---------- 通用 ----------
LOG_LEVEL=INFO
DATA_DIR=./data
REPORTS_DIR=./reports
# Docker 构建时的 pip 源（国内可换清华镜像）
PIP_INDEX_URL=https://pypi.org/simple

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_RAW=raw_comments
KAFKA_CONSUMER_GROUP=opinion-stream-processor
KAFKA_AUTO_OFFSET_RESET=latest

# ---------- Elasticsearch ----------
ES_URL=http://localhost:9200
ES_INDEX_COMMENTS=opinion_comments
ES_INDEX_DECISIONS=tri_agent_decisions
ES_INDEX_ALERTS=opinion_alerts
ES_USERNAME=
ES_PASSWORD=

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=opinion-graph
NEO4J_DATABASE=neo4j
GRAPH_BACKEND=auto            # auto | neo4j | memory

# ---------- ABSA ----------
# auto: DeepSeek(若有 key) -> HuggingFace(若已安装 transformers) -> lexicon
# 可选：lexicon | hf | deepseek
ABSA_BACKEND=auto
ABSA_MODEL=yangheng/deberta-v3-base-absa-v1.1
ABSA_ALLOW_MODEL_DOWNLOAD=false   # 首次使用 HF 模型时设为 true
ABSA_MAX_QUADRUPLES=10

# ---------- Tri-Agent ----------
SDI_THRESHOLD=0.45
FINBERT_MODEL=ProsusAI/finbert
ENABLE_FINBERT=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# DeepSeek 官方价格（USD / 1M tokens），用于成本核算
LLM_INPUT_PRICE_PER_M=0.27
LLM_OUTPUT_PRICE_PER_M=1.10

# ---------- LLM（DeepSeek，OpenAI 兼容协议） ----------
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 告警 ----------
ALERT_WINDOW_SECONDS=300
ALERT_MIN_SAMPLES=8
ALERT_NEGATIVE_RATIO=0.6
ALERT_COOLDOWN_SECONDS=120

# ---------- FastAPI ----------
API_HOST=0.0.0.0
API_PORT=8000
